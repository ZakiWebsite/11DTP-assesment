def print_specific_country(country_name):
    # takes the users desired capital and outputs information about it
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT * FROM country_list WHERE country LIKE ?"
    params = ((f"{country_name}%",))
    # connect the python code to the SQL query
    cursor.execute(sql, params)
    results = cursor.fetchone()
    # check if the capital exists and if it doesn't print an error message.
    if results is None:
        print("Country not found.")
    else:
        # print a header for the information
        print("Name:                                   Population:         Area (sq mi):       GDP per capita (USD):")
        # print the information neatly
        row = results
        print(f"{row[0]:<40}{row[1]:<20}{row[2]:<20}{row[3]:<20}")
    db.close()


