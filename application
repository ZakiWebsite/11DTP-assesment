            print_capitals_age()
        elif choice == 9:
                print_capitals_alphabetically()
        elif choice == 10:
            capital_name = input("Enter the name of the capital you want to search for: ")
            # gets the name of a specific capital
            remove_spaces = capital_name.strip()
            # removes spaces from the input
            formatted_capital_name = remove_spaces.title()
            # formats the input to match the database
            print_specific_capital(formatted_capital_name)
        elif choice == 11:
            break
            # exit the code
        else:
            print('Invalid input.')
    except ValueError:
        # check if the input is invalid, and if it is, print an error message
        print("Invalid input. Please enter a number from 1 to 10.")

print("Thanks for using!")
        


