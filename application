# docstring Zakaria B. country database
import sqlite3

# constants and variables
DATABASE = 'countries.db'
times_used = 0


# functions

def print_country_info():
# prints everything about every country
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT * FROM country_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    print("Name:             Population:    Area (sq mi):  GDP per capita:")
    for row in results:
        print(f"{row[0]:<40}{row[1]:<12}{row[2]:<12}{row[3]:<8}{row[4]:<8}")
    db.close()

def print_capital_info():
# prints everything about every capital
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT * FROM capital_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    for row in results:
        print(f"{row[0]:<40}{row[1]:<12}{row[2]:<12}{row[3]:<8}{row[4]:<8}")
    db.close()

def print_country_size():
# prints the area of each country
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT country, area FROM country_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    for row in results:
        print(f"{row[0]}: {row[1] * 2.58999} km²") # converts square miles to square kilometers
    db.close()

def print_country_population():
# prints the population of every country
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT country, population FROM country_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    for row in results:
        print(f"{row[0]:<40}{row[1]:<12}")
    db.close()

def print_capitals_age():
# print when each capital was established
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT name, date_established FROM capital_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    print(results)
    db.close()

def print_country_gdp_per_capita():
# print gdp per capita of a country in USD
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT country, gdp_per_capita FROM country_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    print(results)
    db.close()

def print_capitals_alphabetically():
# print everything about capitals, but in alphabetical order
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT * FROM capital_list ORDER BY name"
    cursor.execute(sql)
    results = cursor.fetchall()
    print(results)
    db.close()

def print_specific_country(formatted_country_name):
# takes the users desired country and outputs information about it
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT * FROM country_list WHERE country =?"
    params = (formatted_country_name,)
    # connect the python code to the SQL query
    cursor.execute(sql, params)
    results = cursor.fetchall()
    if results == []:
        print("Country not found.")
    else:
        print(results)
    db.close()

def print_specific_capital(formatted_capital_name):
    # takes the users desired capital and outputs information about it
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT * FROM capital_list WHERE name =?"
    params = (formatted_capital_name,)
    # connect the python code to the SQL query
    cursor.execute(sql, params)
    results = cursor.fetchall()
    if results == []:
        print("Capital not found.")
    else:
        print(results)
    db.close()




while True:
    try:
    # Print out a menu for users to select what action they want to do.
        # if the user has already used the database, don't display the 'Welcome' message.
        if times_used == 0:
            print("Welcome to the country database! Please select an option:")
        times_used += 1
        print("Country commands:")
        # show all the options relating to countries
        print("1. Print all country information")
        print("2. Print the population of each country")
        print("3. Print the area of each country in square kilometers")
        print("4. Print the GDP per capita of each country")
        print("5. Search for a specific country")
        print("Capital commands:")
        # show all the options relating to capitals
        print("6. Print all capital information")
        print("7. Print the population of each capital")
        print("8. Print the date established of each capital")
        print("9. Print the capitals in alphabetical order")
        print("10. Search for a specific capital")
        print("11. Exit")
        
        choice = int(input("Choice: "))
        # runs the functions recquired for each input
        if choice == 1:
            print_country_info()
        elif choice == 2:
            print_country_population()
        elif choice == 3:
            print_country_size()
        elif choice == 4:
            print_country_gdp_per_capita()
        elif choice == 5:
            country_name = input("Enter the name of the country you want to search for: ") 
            # gets the name of a specific country
            remove_spaces = country_name.strip()
            # removes spaces from the input
            formatted_country_name = remove_spaces.title()
