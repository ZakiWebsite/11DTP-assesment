def print_top_3_cities(country_name):
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    # Get the country ID first (fixed WHERE clause column name from 'name' to 'country')
    sql = "SELECT country_id FROM country_list WHERE country LIKE ?"
    params = ((f"{country_name}%",))
    cursor.execute(sql, params)
    country_result = cursor.fetchone()
    if country_result is None:
        # check if country exists and if it doesn't print an error message.
        print("Country not found.")
    country_id = country_result[0]
    # Get top 3 cities for that country ID
    sql = "SELECT name, population FROM cities_list WHERE country_id = ? ORDER BY population DESC LIMIT 3"
    params = (country_id,)
    cursor.execute(sql, params)
    city_results = cursor.fetchall()
    if not city_results:
        # check if there are any cities for that country and if there aren't print an error message.
        print("No cities found for this country.")
    else:
        # print the information neatly
        print(f"{'Name:':<40}{'Population:':<20}")
        for row in city_results:
            print(f"{row[0]:<40}{row[1]:<20}")
    db.close()


def print_biggest_city_each_country():
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    # run the sql code to get the biggest city of each country
    sql = "SELECT name, MAX(CAST(population AS INTEGER)) FROM cities_list GROUP BY country_id ORDER BY population DESC"
    cursor.execute(sql)
    city_results = cursor.fetchall()
    # print the information neatly
    print(f"{'Name:':<40}{'Population:':<20}")
    for row in city_results:
        print(f"{row[0]:<40}{row[1]:<20}")
    db.close()


