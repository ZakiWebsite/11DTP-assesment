def print_country_info():
    # prints everything about every country
    db = sqlite3.connect(DATABASE)
    cursor = db.cursor()
    sql = "SELECT country, population, area, gdp_per_capita FROM country_list"
    cursor.execute(sql)
    results = cursor.fetchall()
    # print a header for the information
    print("Name:                                   Population:         Area (sq mi):       GDP per capita (USD):")
    # print the information neatly
    for row in results:
        print(f"{row[0]:<40}{row[1]:<20}{row[2]:<20}{row[3]:<20}")
    db.close()


